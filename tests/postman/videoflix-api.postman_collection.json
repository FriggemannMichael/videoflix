    {
      "name": "Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"confirmed_password\": \"{{password}}\",\n  \"privacy_policy\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/register/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "register",
            ""
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('returns 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('returns the inactive user and an activation token', function () {",
              "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
              "  pm.expect(body.token).to.be.a('string');",
              "});",
              "",
              "const uidb64 = btoa(String(body.user.id))",
              "  .replace(/\\+/g, '-')",
              "  .replace(/\\//g, '_')",
              "  .replace(/=+$/, '');",
              "pm.collectionVariables.set('uid', uidb64);",
              "pm.collectionVariables.set('activationToken', body.token);"
            ]
          }
        }
      ]
    },
