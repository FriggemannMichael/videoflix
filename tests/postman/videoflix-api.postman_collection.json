  "item": [
    {
      "name": "Admin login page is reachable",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/login/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "login",
            ""
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('renders the Django admin login form', function () {",
              "  pm.expect(pm.response.text()).to.include('id_username');",
              "});"
            ]
          }
        }
