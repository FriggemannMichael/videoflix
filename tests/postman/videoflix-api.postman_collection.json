        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const setCookieHeaders = pm.response.headers",
              "  .all()",
              "  .filter((header) => header.key.toLowerCase() === 'set-cookie')",
              "  .map((header) => header.value)",
              "  .join('; ');",
              "",
              "pm.test('returns 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('returns a new access token', function () {",
              "  pm.expect(body.detail).to.eql('Token refreshed');",
