              "});",
              "",
              "pm.test('sets a new HttpOnly access token cookie', function () {",
              "  pm.expect(setCookieHeaders).to.include('access_token=');",
              "  pm.expect(setCookieHeaders).to.include('HttpOnly');",
              "  pm.expect(setCookieHeaders).to.not.include('refresh_token=');",
              "});"
            ]
          }
